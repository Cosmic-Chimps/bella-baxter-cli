<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>bella</AssemblyName>
    <RootNamespace>BellaBaxter.Cli</RootNamespace>
    <Version>0.1.1-preview.96</Version>

    <!-- Global tool support (dev loop: dotnet pack + dotnet tool install -g) -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>bella</ToolCommandName>
    <PackageId>BellaBaxter.Cli</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- Single-file self-contained publish — only active during dotnet publish -r <RID> -->
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <EnableCompressionInSingleFile Condition="'$(RuntimeIdentifier)' != ''"
      >true</EnableCompressionInSingleFile
    >
    <DebugType Condition="'$(RuntimeIdentifier)' != ''">embedded</DebugType>

    <!-- Suppress AOT/trim analysis warnings — we accept runtime JSON reflection -->
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>

    <!-- Required for lean containers (Alpine/distroless) that lack ICU libraries -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.7" />
    <PackageReference Include="Microsoft.Kiota.Http.HttpClientLibrary" Version="1.22.1" />
    <PackageReference Include="Microsoft.Kiota.Serialization.Form" Version="1.22.1" />
    <PackageReference Include="Microsoft.Kiota.Serialization.Json" Version="1.22.1" />
    <PackageReference Include="Microsoft.Kiota.Serialization.Multipart" Version="1.22.1" />
    <PackageReference Include="Microsoft.Kiota.Serialization.Text" Version="1.22.1" />
    <PackageReference Include="ModelContextProtocol" Version="1.2.0" />
    <PackageReference Include="Spectre.Console" Version="0.55.2" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
    <PackageReference Include="VYaml" Version="1.3.0" />
    <PackageReference Include="VYaml.Annotations" Version="1.3.0" />

    <!-- Spec 001 US6: the SPIFFE Workload API is gRPC over a Unix socket, so the agent hosts Kestrel.
         Grpc.AspNetCore brings the server, Google.Protobuf and Grpc.Tools (the protoc build step). -->
    <PackageReference Include="Grpc.AspNetCore" Version="2.71.0" />
  </ItemGroup>

  <!-- FrameworkReference rather than a package: the gRPC server needs the ASP.NET Core shared
       framework. Note the consequence for a framework-dependent global tool — the host needs the
       ASP.NET Core runtime, not just the .NET runtime. `dotnet tool install -g` implies the SDK, which
       includes it, and a self-contained publish bundles it, so both shipping paths are covered. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Both: the agent SERVES this API, and the conformance test plus the SDK auto-detection path
         (T044) need a client for the same schema. Generating the client from the identical vendored
         proto is the point — two hand-kept copies would be free to drift, and a drifted conformance
         test is worse than none. -->
    <Protobuf Include="Protos/workload.proto" GrpcServices="Both" />
  </ItemGroup>

  <!-- Dev (monorepo): direct project reference when BellaBaxter.Client source is on disk -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)../../sdk/dotnet/BellaBaxter.Client/BellaBaxter.Client.csproj')">
    <ProjectReference Include="../../sdk/dotnet/BellaBaxter.Client/BellaBaxter.Client.csproj" />
  </ItemGroup>
  <!-- Publish (public repo bella-baxter-cli): resolve from NuGet when project is absent -->
  <ItemGroup Condition="!Exists('$(MSBuildThisFileDirectory)../../sdk/dotnet/BellaBaxter.Client/BellaBaxter.Client.csproj')">
    <PackageReference Include="BellaBaxter.Client" Version="0.1.1-preview.96" />
  </ItemGroup>

  <!-- Dev (monorepo): direct project reference when BellaBaxter.Crypto source is on disk -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)../../sdk/crypto/BellaBaxter.Crypto.csproj')">
    <ProjectReference Include="../../sdk/crypto/BellaBaxter.Crypto.csproj" />
  </ItemGroup>
  <!-- Publish (public repo): resolve from NuGet when project is absent -->
  <ItemGroup Condition="!Exists('$(MSBuildThisFileDirectory)../../sdk/crypto/BellaBaxter.Crypto.csproj')">
    <PackageReference Include="BellaBaxter.Crypto" Version="0.1.1-preview.96" />
  </ItemGroup>
  <ItemGroup>
    <!-- The test project asserts the pure env/export builders directly (they are internal because
         they are implementation detail of the commands, not public API). -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>BellaBaxter.Cli.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
