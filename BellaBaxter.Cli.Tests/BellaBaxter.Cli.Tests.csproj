<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>BellaBaxter.Cli.Tests</RootNamespace>
  </PropertyGroup>

  <!-- Versions are centrally managed in ../Directory.Packages.props (backlog §4.13), and mirror the
       API suite's central pins so the two suites cannot drift apart. Spec 020 introduced this project
       with inline pins because the CLI solution had no Directory.Packages.props at the time. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Spec 001 T041: the Workload API conformance test dials the agent's real Unix socket with a
         real HTTP/2 gRPC client. Pinned alongside the server's Grpc.AspNetCore in Directory.Packages.props. -->
    <PackageReference Include="Grpc.Net.Client" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BellaBaxter.Cli\BellaBaxter.Cli.csproj" />
  </ItemGroup>

  <!-- Mirrors the API suite's convention (see BellaBaxter.Tests.csproj) -->
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
